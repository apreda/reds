# Public URL of the site (used for Stripe redirects and print-file URLs sent to Printful).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://www.sellmyteam.com

# Stripe — checkout turns on as soon as STRIPE_SECRET_KEY is set.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Printful — paid orders are sent here automatically by the Stripe webhook.
PRINTFUL_API_TOKEN=
# Only needed if your token has access to more than one store.
PRINTFUL_STORE_ID=
# "true" sends orders straight to production (you get charged by Printful).
# Leave unset to create them as drafts you confirm in the Printful dashboard.
PRINTFUL_AUTO_CONFIRM=
